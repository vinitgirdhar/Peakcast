{
  "name": "peakcast",
  "version": "2.0.0",
  "private": true,
  "description": "Prediction market practice app that runs entirely on your device. Demo credits only.",
  "type": "module",
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --import ./tests/setup.ts --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include=server/** --test-coverage-include=shared/** --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 tests/*.test.ts",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "desktop": "node scripts/start-desktop.mjs",
    "desktop:package": "npm run build && node scripts/package-desktop.mjs",
    "check": "npm run test && npm run build",
    "format:check": "prettier --check src server shared tests desktop scripts",
    "review:ui": "node scripts/review-ui.mjs",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "test:api": "node scripts/check-api.mjs",
    "verify": "node scripts/verify.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "build:web": "vite build",
    "serve": "node --env-file-if-exists=.env dist-server/server/index.js"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.10",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.1.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@sinclair/typebox": "^0.34.41",
    "fastify": "^5.12.8",
    "lucide-react": "^0.468.0",
    "motion": "^14.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "^1.17.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.16.1",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^45.3.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  },
  "overrides": {
    "glob": "^14.0.4",
    "minimatch": "^11.0.7"
  }
}
