HOST=127.0.0.1
PORT=3001
# Optional exact HTTPS tunnel origin, without a trailing slash. Localhost remains the default.
PUBLIC_ORIGIN=
DATABASE_PATH=./data/wildcatter.sqlite
# Provider keys are server-only. Set one or more; never use VITE_ variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional existing OpenAI integration.
OPENAI_API_KEY=
OPENAI_MODEL=
AI_DEFAULT_PROVIDER=groq
# Permit paid AI requests from the draft workbench only with this additional server-side secret.
AI_ACCESS_TOKEN=

# Market resolution. OPERATOR_TOKEN (16-256 characters) enables final rulings on
# disputed and house markets; leave empty to disable them.
OPERATOR_TOKEN=
# Seconds a proposed outcome can be disputed before anyone may settle it.
DISPUTE_WINDOW_SECONDS=120

# Hosted demos: HTTPS link the Windows download button redirects to when the
# local build in release/downloads is absent (for example a GitHub release asset).
WINDOWS_DOWNLOAD_URL=
ANDROID_DOWNLOAD_URL=
