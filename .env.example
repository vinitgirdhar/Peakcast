# Settings for the optional Node API server (npm run serve) and its tests.
# The web, Android and Windows apps need none of these: they run on the device.
HOST=127.0.0.1
PORT=3001
# Optional exact HTTPS origin, without a trailing slash. Localhost remains the default.
PUBLIC_ORIGIN=
DATABASE_PATH=./data/peakcast.sqlite

# Market resolution. OPERATOR_TOKEN (16-256 characters) enables final rulings on
# disputed and house markets; leave empty to disable them.
OPERATOR_TOKEN=
# Seconds a proposed outcome can be disputed before anyone may settle it.
DISPUTE_WINDOW_SECONDS=120

# HTTPS links the server's /downloads/ routes redirect to when the local build in
# release/downloads is absent (for example a GitHub release asset).
WINDOWS_DOWNLOAD_URL=
ANDROID_DOWNLOAD_URL=
